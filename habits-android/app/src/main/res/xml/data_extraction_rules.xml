<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer read this instead of backup_rules.xml. Same choice,
     for the cloud backup and for moving to a new phone alike. -->
<data-extraction-rules>
  <cloud-backup>
    <include domain="root" path="app_webview/Default/Local Storage" />
    <include domain="sharedpref" path="glow_shell.xml" />
  </cloud-backup>
  <device-transfer>
    <include domain="root" path="app_webview/Default/Local Storage" />
    <include domain="sharedpref" path="glow_shell.xml" />
  </device-transfer>
</data-extraction-rules>
