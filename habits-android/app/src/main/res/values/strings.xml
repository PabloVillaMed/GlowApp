<?xml version="1.0" encoding="utf-8"?>
<!-- Only what Android shows outside the app. Everything the widget and the
     notifications print comes from the page, in the app's own language; these
     are the fallbacks and the names in the system's settings screens. -->
<resources>
  <string name="app_name" translatable="false">GlowApp</string>

  <!-- Notification channels -->
  <string name="cast_channel">Messages from your character</string>
  <string name="cast_channel_desc">Reminders sent as chat messages, with a voice note</string>
  <string name="reminder_channel">Reminders</string>
  <string name="reminder_channel_desc">Plain daily nudges for the habits you scheduled</string>
  <string name="reminder_title">Done with “%1$s” yet?</string>
  <string name="reminder_body">Mark it done from here, or open GlowApp.</string>
  <string name="mark_done">Done</string>

  <!-- Widget -->
  <string name="widget_label">GlowApp — Today</string>
  <string name="widget_description">Today\'s habits: tick them off and add glasses of water without opening the app.</string>
  <string name="widget_empty">Open GlowApp to get started</string>
</resources>
