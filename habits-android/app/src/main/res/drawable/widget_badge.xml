<?xml version="1.0" encoding="utf-8"?>
<!-- The emoji's tile: a faint fill and a firmer edge, both white so the widget
     can tint them with the habit's colour. The transparency is in the colours
     themselves, which a tint keeps. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="rectangle">
      <solid android:color="#38FFFFFF" />
      <corners android:radius="10dp" />
    </shape>
  </item>
  <item>
    <shape android:shape="rectangle">
      <!-- An explicit clear fill: a shape with only a stroke is filled solid
           when tinted, which turned the whole tile the habit's colour. -->
      <solid android:color="#00FFFFFF" />
      <stroke android:width="1dp" android:color="#8CFFFFFF" />
      <corners android:radius="10dp" />
    </shape>
  </item>
</layer-list>
