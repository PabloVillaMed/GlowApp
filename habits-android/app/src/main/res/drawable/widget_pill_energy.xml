<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's energy button (2.26): a row-coloured pill that shows a press. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/widget_press">
  <item>
    <shape android:shape="rectangle">
      <solid android:color="@color/widget_row" />
      <corners android:radius="999dp" />
    </shape>
  </item>
</ripple>
